#!/bin/bash
# MagOS project
# Authors: Mikhail Zaripov
ENABLED=yes
[ "$ENABLED" != "yes" ] && exit 0

DEBUGMODE=no
. /usr/lib/magos/functions
debug_mode "$0" "$@"

#remove kernel modules kvm* to prevent conflict with virtualbox
[ -x /usr/bin/VirtualBox -a ! -x /usr/bin/qemu-kvm ] && modprobe -r $(lsmod | grep kvm | awk '{print $1}' | grep kvm | tr \\n " ")